# CreaCas CMS Environment Variables
# Copy to .env and fill in values

# Admin login
CMS_USER=admin
CMS_PASSWORD_HASH=$2b$10$... # Generate with: node -e "require('bcrypt').hash('your-password', 10).then(h => console.log(h))"

# Session secret (generate random string)
SESSION_SECRET=change-me-to-a-random-string

# Server
PORT=3000
NODE_ENV=production
