<% const active = 'dashboard' %>
<%- include('layout-header') %>

<div class="page-header">
  <h1>Dashboard</h1>
  <p>Welkom bij het CreaCas CMS. Beheer hier je website content.</p>
</div>

<div class="stats-grid">
  <a href="/backend/hero" class="stat-card">
    <div class="stat-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
    </div>
    <div class="stat-info">
      <span class="stat-number"><%= slideCount %></span>
      <span class="stat-label">Hero Slides</span>
    </div>
  </a>

  <a href="/backend/portfolio" class="stat-card">
    <div class="stat-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
    </div>
    <div class="stat-info">
      <span class="stat-number"><%= projectCount %></span>
      <span class="stat-label">Portfolio Projecten</span>
    </div>
  </a>

  <a href="/backend/services" class="stat-card">
    <div class="stat-icon">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
    </div>
    <div class="stat-info">
      <span class="stat-number"><%= serviceCount %></span>
      <span class="stat-label">Services</span>
    </div>
  </a>
</div>

<div class="quick-links">
  <h2>Snel naar</h2>
  <div class="link-grid">
    <a href="/backend/hero" class="link-card">Hero sectie bewerken</a>
    <a href="/backend/portfolio" class="link-card">Portfolio beheren</a>
    <a href="/backend/services" class="link-card">Services bewerken</a>
    <a href="/backend/about" class="link-card">Over Mij bewerken</a>
    <a href="/backend/contact" class="link-card">Contact & Social</a>
    <a href="/backend/settings" class="link-card">Site instellingen</a>
  </div>
</div>

<%- include('layout-footer') %>
