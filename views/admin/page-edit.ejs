<% const active = 'pages' %>
<%- include('layout-header') %>

<div class="page-header">
  <div class="page-header-row">
    <div>
      <h1><%= page.title %></h1>
      <p>Bewerk pagina-instellingen, afbeelding en content.</p>
    </div>
    <a href="/backend/pages" class="btn btn-secondary">Terug naar Pagina's</a>
  </div>
</div>

<!-- Settings -->
<div class="card">
  <div class="card-header">
    <h2>Instellingen</h2>
  </div>
  <div class="card-body">
    <form id="settingsForm">
      <div class="form-row">
        <div class="form-group">
          <label>Titel</label>
          <input type="text" id="pageTitle" value="<%= page.title %>" class="form-control">
        </div>
        <div class="form-group">
          <label>Slug</label>
          <input type="text" id="pageSlug" value="<%= page.slug %>" class="form-control">
          <span class="form-help">URL: creacas.nl/<span id="slugPreview"><%= page.slug %></span></span>
        </div>
      </div>
      <div class="form-group">
        <label>Meta beschrijving</label>
        <textarea id="pageMeta" class="form-control" rows="2" placeholder="Korte beschrijving voor zoekmachines"><%= page.meta_description %></textarea>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label class="checkbox-label">
            <input type="checkbox" id="pagePublished" <%= page.published ? 'checked' : '' %>>
            Gepubliceerd
          </label>
        </div>
        <div class="form-group">
          <label class="checkbox-label">
            <input type="checkbox" id="pageShowInNav" <%= page.show_in_nav ? 'checked' : '' %>>
            Tonen in navigatie
          </label>
        </div>
      </div>
      <button type="submit" class="btn btn-primary">Instellingen opslaan</button>
    </form>
  </div>
</div>

<!-- Featured Image -->
<div class="card">
  <div class="card-header">
    <h2>Featured Image</h2>
  </div>
  <div class="card-body">
    <div class="image-upload-area">
      <% if (page.featured_image) { %>
      <img src="<%= page.featured_image %>" alt="Featured" class="preview-image" id="featuredPreview">
      <% } else { %>
      <img src="" alt="Geen afbeelding" class="preview-image" id="featuredPreview" style="display:none">
      <% } %>
      <div>
        <input type="file" id="featuredInput" accept="image/*" class="form-control" style="max-width:300px">
        <div class="form-actions" style="margin-top:0.75rem">
          <button class="btn btn-primary btn-sm" onclick="uploadFeaturedImage()">Uploaden</button>
          <% if (page.featured_image) { %>
          <button class="btn btn-danger btn-sm" onclick="deleteFeaturedImage()">Verwijderen</button>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Content -->
<div class="card">
  <div class="card-header">
    <h2>Content</h2>
  </div>
  <div class="card-body">
    <div id="quillToolbar">
      <span class="ql-formats">
        <button class="ql-bold"></button>
        <button class="ql-italic"></button>
      </span>
      <span class="ql-formats">
        <select class="ql-header">
          <option value="1">H1</option>
          <option value="2">H2</option>
          <option value="3">H3</option>
          <option selected value="">Normaal</option>
        </select>
      </span>
      <span class="ql-formats">
        <button class="ql-list" value="ordered"></button>
        <button class="ql-list" value="bullet"></button>
        <button class="ql-blockquote"></button>
      </span>
      <span class="ql-formats">
        <button class="ql-link"></button>
        <button class="ql-image"></button>
      </span>
      <span class="ql-formats">
        <button class="ql-clean"></button>
      </span>
    </div>
    <div id="quillEditor" class="quill-editor"></div>
    <button class="btn btn-primary" style="margin-top:1rem" onclick="saveContent()">Content opslaan</button>
  </div>
</div>

<script>
const pageId = <%= page.id %>;

// Slug preview
document.getElementById('pageSlug').addEventListener('input', (e) => {
  document.getElementById('slugPreview').textContent = e.target.value;
});

// Save settings
document.getElementById('settingsForm').addEventListener('submit', async (e) => {
  e.preventDefault();
  const data = {
    title: document.getElementById('pageTitle').value,
    slug: document.getElementById('pageSlug').value,
    meta_description: document.getElementById('pageMeta').value,
    published: document.getElementById('pagePublished').checked,
    show_in_nav: document.getElementById('pageShowInNav').checked
  };
  const res = await fetch(`/backend/api/pages/${pageId}`, {
    method: 'PUT',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(data)
  });
  const result = await res.json();
  if (res.ok) showToast('Instellingen opgeslagen!');
  else showToast(result.error || 'Opslaan mislukt', 'error');
});

// Featured image upload
async function uploadFeaturedImage() {
  const input = document.getElementById('featuredInput');
  if (!input.files[0]) return showToast('Selecteer eerst een afbeelding', 'error');
  const form = new FormData();
  form.append('image', input.files[0]);
  const res = await fetch(`/backend/api/pages/${pageId}/image`, { method: 'POST', body: form });
  if (res.ok) { showToast('Afbeelding geüpload!'); location.reload(); }
  else showToast('Upload mislukt', 'error');
}

async function deleteFeaturedImage() {
  if (!confirm('Featured image verwijderen?')) return;
  const res = await fetch(`/backend/api/pages/${pageId}/image`, { method: 'DELETE' });
  if (res.ok) { showToast('Afbeelding verwijderd'); location.reload(); }
  else showToast('Verwijderen mislukt', 'error');
}

// Quill editor
let quill;
document.addEventListener('DOMContentLoaded', () => {
  quill = new Quill('#quillEditor', {
    theme: 'snow',
    modules: {
      toolbar: '#quillToolbar'
    }
  });
  quill.root.innerHTML = <%- JSON.stringify(page.content) %>;
});

async function saveContent() {
  const content = quill.root.innerHTML;
  const res = await fetch(`/backend/api/pages/${pageId}`, {
    method: 'PUT',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ content })
  });
  if (res.ok) showToast('Content opgeslagen!');
  else showToast('Opslaan mislukt', 'error');
}
</script>

<%- include('layout-footer') %>
