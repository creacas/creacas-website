<% const active = 'pages' %>
<%- include('layout-header') %>

<div class="page-header">
  <div class="page-header-row">
    <div>
      <h1><%= page.title %></h1>
      <p>Bewerk pagina-instellingen, afbeelding en widgets.</p>
    </div>
    <div class="form-actions">
      <button class="btn btn-primary" onclick="saveAllWidgets()">Alles opslaan</button>
      <a href="/backend/pages" class="btn btn-secondary">Terug naar Pagina's</a>
    </div>
  </div>
</div>

<!-- Settings -->
<div class="card">
  <div class="card-header">
    <h2>Instellingen</h2>
  </div>
  <div class="card-body">
    <form id="settingsForm">
      <div class="form-row">
        <div class="form-group">
          <label>Titel</label>
          <input type="text" id="pageTitle" value="<%= page.title %>" class="form-control">
        </div>
        <div class="form-group">
          <label>Slug</label>
          <input type="text" id="pageSlug" value="<%= page.slug %>" class="form-control">
          <span class="form-help">URL: creacas.nl/<span id="slugPreview"><%= page.slug %></span></span>
        </div>
      </div>
      <div class="form-group">
        <label>Meta beschrijving</label>
        <textarea id="pageMeta" class="form-control" rows="2" placeholder="Korte beschrijving voor zoekmachines"><%= page.meta_description %></textarea>
      </div>
      <div class="form-row">
        <div class="form-group">
          <label class="checkbox-label">
            <input type="checkbox" id="pagePublished" <%= page.published ? 'checked' : '' %>>
            Gepubliceerd
          </label>
        </div>
        <div class="form-group">
          <label class="checkbox-label">
            <input type="checkbox" id="pageShowInNav" <%= page.show_in_nav ? 'checked' : '' %>>
            Tonen in navigatie
          </label>
        </div>
      </div>
      <button type="submit" class="btn btn-primary">Instellingen opslaan</button>
    </form>
  </div>
</div>

<!-- Featured Image -->
<div class="card">
  <div class="card-header">
    <h2>Featured Image</h2>
  </div>
  <div class="card-body">
    <div class="image-upload-area">
      <% if (page.featured_image) { %>
      <img src="<%= page.featured_image %>" alt="Featured" class="preview-image" id="featuredPreview">
      <% } else { %>
      <img src="" alt="Geen afbeelding" class="preview-image" id="featuredPreview" style="display:none">
      <% } %>
      <div>
        <input type="file" id="featuredInput" accept="image/*" class="form-control" style="max-width:300px">
        <div class="form-actions" style="margin-top:0.75rem">
          <button class="btn btn-primary btn-sm" onclick="uploadFeaturedImage()">Uploaden</button>
          <% if (page.featured_image) { %>
          <button class="btn btn-danger btn-sm" onclick="deleteFeaturedImage()">Verwijderen</button>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Widgets -->
<div class="card">
  <div class="card-header">
    <h2>Content Widgets</h2>
    <button class="btn btn-primary btn-sm" onclick="saveAllWidgets()">Alles opslaan</button>
  </div>
  <div class="card-body">
    <div id="widgetList" class="widget-list"></div>

    <div class="widget-add-section">
      <button class="btn btn-secondary" onclick="toggleWidgetPicker()" id="widgetPickerToggle">+ Widget toevoegen</button>
      <div id="widgetPicker" class="widget-picker">
        <button class="widget-type-btn" onclick="addWidget('text')" title="Tekst">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7"/></svg>
          <span>Tekst</span>
        </button>
        <button class="widget-type-btn" onclick="addWidget('heading')" title="Heading">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 18h7M4 12h3m5 0h8"/></svg>
          <span>Heading</span>
        </button>
        <button class="widget-type-btn" onclick="addWidget('spacer')" title="Spacer">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 12h16M12 4v4m0 8v4"/></svg>
          <span>Spacer</span>
        </button>
        <button class="widget-type-btn" onclick="addWidget('image')" title="Afbeelding">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          <span>Afbeelding</span>
        </button>
        <button class="widget-type-btn" onclick="addWidget('gallery')" title="Galerij">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zm10 0a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zm10 0a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
          <span>Galerij</span>
        </button>
        <button class="widget-type-btn" onclick="addWidget('video')" title="Video">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/><path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <span>Video</span>
        </button>
        <button class="widget-type-btn" onclick="addWidget('columns')" title="Kolommen">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 4H5a1 1 0 00-1 1v14a1 1 0 001 1h4a1 1 0 001-1V5a1 1 0 00-1-1zm10 0h-4a1 1 0 00-1 1v14a1 1 0 001 1h4a1 1 0 001-1V5a1 1 0 00-1-1z"/></svg>
          <span>Kolommen</span>
        </button>
        <button class="widget-type-btn" onclick="addWidget('cards')" title="Cards">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
          <span>Cards</span>
        </button>
        <button class="widget-type-btn" onclick="addWidget('cta')" title="Call to Action">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5.882V19.24a1.76 1.76 0 01-3.417.592l-2.147-6.15M18 13a3 3 0 100-6M5.436 13.683A4.001 4.001 0 017 6h1.832c4.1 0 7.625-1.234 9.168-3v14c-1.543-1.766-5.067-3-9.168-3H7a3.988 3.988 0 01-1.564-.317z"/></svg>
          <span>CTA</span>
        </button>
        <button class="widget-type-btn" onclick="addWidget('accordion')" title="Accordion">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16m-7 6h7"/></svg>
          <span>Accordion</span>
        </button>
        <button class="widget-type-btn" onclick="addWidget('quote')" title="Quote">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"/></svg>
          <span>Quote</span>
        </button>
      </div>
    </div>
  </div>
</div>

<script src="/js/widget-editor.js"></script>

<script>
const pageId = <%= page.id %>;
const initialWidgets = <%- JSON.stringify(widgets) %>;

// Slug preview
document.getElementById('pageSlug').addEventListener('input', (e) => {
  document.getElementById('slugPreview').textContent = e.target.value;
});

// Save settings
document.getElementById('settingsForm').addEventListener('submit', async (e) => {
  e.preventDefault();
  const data = {
    title: document.getElementById('pageTitle').value,
    slug: document.getElementById('pageSlug').value,
    meta_description: document.getElementById('pageMeta').value,
    published: document.getElementById('pagePublished').checked,
    show_in_nav: document.getElementById('pageShowInNav').checked
  };
  const res = await fetch(`/backend/api/pages/${pageId}`, {
    method: 'PUT',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(data)
  });
  const result = await res.json();
  if (res.ok) showToast('Instellingen opgeslagen!');
  else showToast(result.error || 'Opslaan mislukt', 'error');
});

// Featured image upload
async function uploadFeaturedImage() {
  const input = document.getElementById('featuredInput');
  if (!input.files[0]) return showToast('Selecteer eerst een afbeelding', 'error');
  const form = new FormData();
  form.append('image', input.files[0]);
  const res = await fetch(`/backend/api/pages/${pageId}/image`, { method: 'POST', body: form });
  if (res.ok) { showToast('Afbeelding geupload!'); location.reload(); }
  else showToast('Upload mislukt', 'error');
}

async function deleteFeaturedImage() {
  if (!confirm('Featured image verwijderen?')) return;
  const res = await fetch(`/backend/api/pages/${pageId}/image`, { method: 'DELETE' });
  if (res.ok) { showToast('Afbeelding verwijderd'); location.reload(); }
  else showToast('Verwijderen mislukt', 'error');
}

// Init widget editor
document.addEventListener('DOMContentLoaded', () => {
  initWidgetEditor(pageId, initialWidgets);
});
</script>

<%- include('layout-footer') %>
