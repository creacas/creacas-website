<% const c = widget.config; const items = c.items || []; %>
<div class="widget widget-accordion">
  <% items.forEach((item, idx) => { %>
    <div class="widget-accordion-item">
      <button class="widget-accordion-trigger" onclick="this.parentElement.classList.toggle('active')">
        <span><%= item.title || 'Item' %></span>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
      </button>
      <div class="widget-accordion-content page-content">
        <%- item.content || '' %>
      </div>
    </div>
  <% }) %>
</div>
