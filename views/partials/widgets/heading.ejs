<% const c = widget.config; const align = c.alignment || 'left'; %>
<div class="widget widget-heading" style="text-align:<%= align %>">
  <% if (c.level === 1) { %>
    <h1><%= c.text || '' %></h1>
  <% } else if (c.level === 3) { %>
    <h3><%= c.text || '' %></h3>
  <% } else { %>
    <h2><%= c.text || '' %></h2>
  <% } %>
  <% if (align === 'center') { %><div class="accent-line"></div><% } %>
  <% if (c.subtitle) { %>
    <p class="widget-heading-subtitle"><%= c.subtitle %></p>
  <% } %>
</div>
