<% const c = widget.config; %>
<div class="widget widget-quote">
  <blockquote>
    <p><%= c.text || '' %></p>
    <% if (c.author || c.source) { %>
      <footer>
        <% if (c.author) { %><cite class="widget-quote-author"><%= c.author %></cite><% } %>
        <% if (c.source) { %><span class="widget-quote-source"><%= c.source %></span><% } %>
      </footer>
    <% } %>
  </blockquote>
</div>
