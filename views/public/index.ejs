<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="<%= settings.meta_description || '' %>">
  <meta name="keywords" content="<%= settings.meta_keywords || '' %>">
  <meta name="author" content="CreaCas">

  <title><%= settings.site_title || 'CreaCas' %></title>

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">

  <!-- Stylesheet -->
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <!-- Header -->
  <header>
    <nav>
      <a href="#home" class="logo">
        <img src="/assets/logo-dark.svg" alt="CreaCas Logo" class="logo-dark">
        <img src="/assets/logo-light.svg" alt="CreaCas Logo" class="logo-light">
        <span>CreaCas</span>
      </a>

      <ul class="nav-links">
        <li><a href="#home" class="active">Home</a></li>
        <li><a href="#portfolio">Portfolio</a></li>
        <li><a href="#services">Services</a></li>
        <li><a href="#about">Over Mij</a></li>
        <% if (typeof navPages !== 'undefined' && navPages.length > 0) { %>
        <% navPages.forEach(p => { %>
        <li><a href="/<%= p.slug %>"><%= p.title %></a></li>
        <% }) %>
        <% } %>
        <li><a href="#contact">Contact</a></li>
      </ul>

      <button class="theme-toggle" aria-label="Toggle dark mode">
        <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <div class="menu-toggle" aria-label="Menu">
        <span></span>
        <span></span>
        <span></span>
      </div>
    </nav>
  </header>

  <!-- Hero Section -->
  <section id="home">
    <!-- Hero Background Slider -->
    <div class="hero-slider">
      <% heroSlides.forEach((slide, i) => { %>
      <div class="hero-slide<%= i === 0 ? ' active' : '' %>">
        <img src="<%= slide.image_path %>" alt="<%= slide.alt_text %>">
      </div>
      <% }) %>
    </div>
    <div class="hero-overlay"></div>

    <% if (hero) { %>
    <div class="hero-content">
      <h1><%- hero.heading %></h1>
      <p class="hero-tagline"><%= hero.tagline %></p>
      <div class="hero-buttons">
        <a href="<%= hero.button_primary_link %>" class="btn btn-primary"><%= hero.button_primary_text %></a>
        <a href="<%= hero.button_secondary_link %>" class="btn btn-outline"><%= hero.button_secondary_text %></a>
      </div>
    </div>
    <% } %>

    <!-- Slider Indicators -->
    <div class="hero-indicators">
      <% heroSlides.forEach((slide, i) => { %>
      <button class="hero-indicator<%= i === 0 ? ' active' : '' %>" data-slide="<%= i %>" aria-label="Slide <%= i + 1 %>"></button>
      <% }) %>
    </div>

    <!-- Scroll Indicator -->
    <div class="scroll-indicator">
      <span>Scroll</span>
    </div>
  </section>

  <!-- Portfolio Section -->
  <section id="portfolio">
    <div class="container">
      <div class="section-header fade-in">
        <h2><%= settings.portfolio_heading || 'Portfolio' %></h2>
        <div class="accent-line"></div>
        <p><%= settings.portfolio_subtitle || '' %></p>
      </div>

      <div class="portfolio-filter fade-in">
        <button class="filter-btn active" data-filter="all">Alles</button>
        <% categories.forEach(cat => { %>
        <button class="filter-btn" data-filter="<%= cat.slug %>"><%= cat.filter_label %></button>
        <% }) %>
      </div>

      <div class="portfolio-grid">
        <% projects.forEach(project => { %>
        <div class="portfolio-item fade-in" data-category="<%= project.category_slug %>" data-gallery="<%= project.slug %>">
          <img src="<%= project.cover_image %>" alt="<%= project.title %>" loading="lazy">
          <div class="portfolio-overlay">
            <span class="category"><%= project.category_name %></span>
            <h3><%= project.title %></h3>
            <p><%= project.description %></p>
          </div>
        </div>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- Services Section -->
  <section id="services">
    <div class="container">
      <div class="section-header fade-in">
        <h2><%= settings.services_heading || 'Services' %></h2>
        <div class="accent-line"></div>
        <p><%= settings.services_subtitle || '' %></p>
      </div>

      <div class="services-grid">
        <% services.forEach(service => { %>
        <div class="service-card fade-in">
          <div class="service-icon">
            <%- service.icon_svg %>
          </div>
          <h3><%= service.title %></h3>
          <p><%= service.description %></p>
          <% if (service.button_text && service.button_link) { %>
          <a href="<%= service.button_link %>" class="btn service-btn">
              <%= service.button_text %>
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          <% } %>
        </div>
        <% }) %>
      </div>
    </div>
  </section>

  <!-- About Section -->
  <section id="about">
    <div class="container">
      <div class="about-content">
        <% if (about) { %>
        <div class="about-image fade-in">
          <img src="<%= about.image_path %>" alt="CreaCas - Over Mij" loading="lazy">
        </div>

        <div class="about-text fade-in">
          <h2><%= about.heading %></h2>
          <div class="accent-line" style="margin: 1.5rem 0;"></div>
          <%- about.content %>

          <div class="about-stats">
            <% aboutStats.forEach(stat => { %>
            <div class="stat">
              <span class="stat-number"><%= stat.number %></span>
              <span class="stat-label"><%= stat.label %></span>
            </div>
            <% }) %>
          </div>
        </div>
        <% } %>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section id="contact">
    <div class="container">
      <div class="section-header fade-in">
        <h2><%= settings.contact_heading || 'Contact' %></h2>
        <div class="accent-line"></div>
        <p><%= settings.contact_subtitle || '' %></p>
      </div>

      <div class="contact-content">
        <div class="contact-info fade-in">
          <div class="contact-item">
            <div class="contact-item-icon">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <div class="contact-item-text">
              <h4>E-mail</h4>
              <p><a href="mailto:<%= settings.contact_email || '' %>"><%= settings.contact_email || '' %></a></p>
            </div>
          </div>

          <div class="contact-item">
            <div class="contact-item-icon">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <div class="contact-item-text">
              <h4>Locatie</h4>
              <p><%= settings.contact_location || '' %></p>
            </div>
          </div>

          <div class="social-links">
            <% socialLinks.forEach(link => { %>
            <a href="<%= link.url %>" target="_blank" rel="noopener" class="social-link" aria-label="<%= link.platform %>">
              <%- link.icon_svg %>
            </a>
            <% }) %>
          </div>
        </div>

        <form class="contact-form fade-in" id="contactForm">
          <div class="form-group">
            <input type="text" name="name" placeholder="Je naam" required>
          </div>
          <div class="form-group">
            <input type="email" name="email" placeholder="Je e-mailadres" required>
          </div>
          <div class="form-group">
            <input type="text" name="subject" placeholder="Onderwerp">
          </div>
          <div class="form-group">
            <textarea name="message" placeholder="Je bericht" required></textarea>
          </div>
          <button type="submit" class="btn btn-primary">
            Verstuur Bericht
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </button>
        </form>
      </div>
    </div>
  </section>

  <!-- Footer -->
  <footer>
    <div class="container">
      <p><%- settings.footer_text || '&copy; 2026 CreaCas. Alle rechten voorbehouden.' %> | <a href="#home">creacas.nl</a></p>
    </div>
  </footer>

  <!-- Gallery Modal -->
  <div class="gallery-modal" id="galleryModal">
    <div class="gallery-modal-header">
      <div>
        <h2 id="galleryTitle">Gallery</h2>
        <span class="category-tag" id="galleryCategory">Fotografie</span>
      </div>
      <button class="gallery-close" aria-label="Sluiten">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
    <div class="gallery-modal-content">
      <div class="gallery-grid" id="galleryGrid">
        <!-- Gallery items injected by JS -->
      </div>
    </div>
  </div>

  <!-- Image Viewer -->
  <div class="image-viewer" id="imageViewer">
    <button class="image-viewer-close" aria-label="Sluiten">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
    <button class="image-viewer-nav image-viewer-prev" aria-label="Vorige">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
    </button>
    <img src="" alt="" id="viewerImage">
    <button class="image-viewer-nav image-viewer-next" aria-label="Volgende">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
      </svg>
    </button>
    <div class="image-viewer-counter"><span id="currentIndex">1</span> / <span id="totalImages">1</span></div>
  </div>

  <!-- Gallery data from server -->
  <script>window.__GALLERY_DATA__ = <%- galleryData %>;</script>

  <!-- JavaScript -->
  <script src="/js/main.js"></script>
</body>
</html>
