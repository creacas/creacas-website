<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="<%= page.meta_description || '' %>">
  <meta name="author" content="CreaCas">

  <title><%= page.title %> - <%= settings.site_title || 'CreaCas' %></title>

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">

  <!-- Stylesheet -->
  <link rel="stylesheet" href="/css/style.css?v=<%= v %>">
</head>
<body>
  <!-- Header -->
  <header>
    <nav>
      <a href="/" class="logo">
        <img src="/assets/logo-dark.svg" alt="CreaCas Logo" class="logo-dark">
        <img src="/assets/logo-light.svg" alt="CreaCas Logo" class="logo-light">
        <span>CreaCas</span>
      </a>

      <ul class="nav-links">
        <li><a href="/">Home</a></li>
        <li><a href="/#portfolio">Portfolio</a></li>
        <li><a href="/#services">Services</a></li>
        <li><a href="/#about">Over Mij</a></li>
        <% if (typeof navPages !== 'undefined' && navPages.length > 0) { %>
        <% navPages.forEach(p => { %>
        <li><a href="/<%= p.slug %>"<%= p.slug === page.slug ? ' class="active"' : '' %>><%= p.title %></a></li>
        <% }) %>
        <% } %>
        <li><a href="/#contact">Contact</a></li>
      </ul>

      <button class="theme-toggle" aria-label="Toggle dark mode">
        <svg class="icon-sun" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <svg class="icon-moon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <div class="menu-toggle" aria-label="Menu">
        <span></span>
        <span></span>
        <span></span>
      </div>
    </nav>
  </header>

  <!-- Page Content -->
  <section class="page-section">
    <div class="container">
      <% if (page.featured_image) { %>
      <img src="<%= page.featured_image %>" alt="<%= page.title %>" class="page-featured-image">
      <% } %>

      <h1 class="page-title"><%= page.title %></h1>
      <div class="accent-line" style="margin: 1.5rem 0 2rem;"></div>

      <% if (typeof widgets !== 'undefined' && widgets.length > 0) { %>
        <div class="page-widgets">
          <% const validTypes = ['text','heading','spacer','image','gallery','video','columns','cards','cta','accordion','quote','before-after']; %>
          <% widgets.forEach(widget => { %>
            <% if (validTypes.includes(widget.type)) { %>
              <%- include('../partials/widgets/' + widget.type, { widget }) %>
            <% } %>
          <% }) %>
        </div>
      <% } else if (page.content) { %>
        <div class="page-content">
          <%- page.content %>
        </div>
      <% } %>
    </div>
  </section>

  <!-- Footer -->
  <footer>
    <div class="container">
      <p><%- settings.footer_text || '&copy; 2026 CreaCas. Alle rechten voorbehouden.' %> | <a href="/">creacas.nl</a></p>
    </div>
  </footer>

  <!-- JavaScript -->
  <script src="/js/main.js"></script>
  <script>
    // Gallery lightbox
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('.widget-gallery').forEach(gallery => {
        const items = gallery.querySelectorAll('.lightbox-trigger');
        const lightbox = gallery.querySelector('.widget-lightbox');
        if (!lightbox || !items.length) return;

        const lbImg = lightbox.querySelector('.widget-lightbox-img');
        const lbCounter = lightbox.querySelector('.widget-lightbox-counter');
        const images = [...items].map(el => el.querySelector('img').dataset.full);
        let currentIdx = 0;

        function show(idx) {
          currentIdx = idx;
          lbImg.src = images[idx];
          lbCounter.textContent = `${idx + 1} / ${images.length}`;
          lightbox.classList.add('active');
          document.body.style.overflow = 'hidden';
        }

        function hide() {
          lightbox.classList.remove('active');
          document.body.style.overflow = '';
        }

        items.forEach((item, idx) => {
          item.addEventListener('click', () => show(idx));
        });

        lightbox.querySelector('.widget-lightbox-close').addEventListener('click', hide);
        lightbox.querySelector('.widget-lightbox-prev').addEventListener('click', () => {
          show((currentIdx - 1 + images.length) % images.length);
        });
        lightbox.querySelector('.widget-lightbox-next').addEventListener('click', () => {
          show((currentIdx + 1) % images.length);
        });
        lightbox.addEventListener('click', (e) => {
          if (e.target === lightbox) hide();
        });
      });

      // Keyboard nav for lightbox
      document.addEventListener('keydown', (e) => {
        const activeLb = document.querySelector('.widget-lightbox.active');
        if (!activeLb) return;
        if (e.key === 'Escape') activeLb.querySelector('.widget-lightbox-close').click();
        if (e.key === 'ArrowLeft') activeLb.querySelector('.widget-lightbox-prev').click();
        if (e.key === 'ArrowRight') activeLb.querySelector('.widget-lightbox-next').click();
      });

      // Before/After sliders
      document.querySelectorAll('.ba-container').forEach(container => {
        const beforeWrapper = container.querySelector('.ba-before-wrapper');
        const sliderLine = container.querySelector('.ba-slider-line');
        const beforeImg = beforeWrapper.querySelector('.ba-image');
        const startPos = parseInt(container.dataset.start) || 50;
        let isDragging = false;

        function setPosition(pct) {
          pct = Math.max(0, Math.min(100, pct));
          beforeWrapper.style.width = pct + '%';
          sliderLine.style.left = pct + '%';
          // Match the before image width to the container width
          beforeImg.style.width = container.offsetWidth + 'px';
        }

        function getPercent(clientX) {
          const rect = container.getBoundingClientRect();
          return ((clientX - rect.left) / rect.width) * 100;
        }

        // Set initial position
        setPosition(startPos);

        // Recalculate on resize
        window.addEventListener('resize', () => {
          beforeImg.style.width = container.offsetWidth + 'px';
        });

        // Mouse events
        container.addEventListener('mousedown', (e) => {
          e.preventDefault();
          isDragging = true;
          setPosition(getPercent(e.clientX));
        });
        document.addEventListener('mousemove', (e) => {
          if (!isDragging) return;
          setPosition(getPercent(e.clientX));
        });
        document.addEventListener('mouseup', () => { isDragging = false; });

        // Touch events
        container.addEventListener('touchstart', (e) => {
          isDragging = true;
          setPosition(getPercent(e.touches[0].clientX));
        }, { passive: true });
        container.addEventListener('touchmove', (e) => {
          if (!isDragging) return;
          setPosition(getPercent(e.touches[0].clientX));
        }, { passive: true });
        container.addEventListener('touchend', () => { isDragging = false; });
      });
    });
  </script>
</body>
</html>
